# ChainPulse environment configuration.
# Copy to .env for local development:  cp .env.example .env
# Real environment variables always override values in .env.

# --- Logging ---
LOG_LEVEL=info                 # debug | info | warn | error

# --- Server ---
SERVER_ADDR=:8080
SERVER_SHUTDOWN_TIMEOUT=10s

# --- Postgres ---
# Matches docker-compose.yml credentials. sslmode=disable for local only.
POSTGRES_DSN=postgres://chainpulse:chainpulse@localhost:5432/chainpulse?sslmode=disable

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=chainpulse

# --- Auth (JWT, HMAC-SHA256) ---
# Generate a strong secret for anything beyond local dev:  openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# --- Policy engine ---
POLICY_CACHE_REFRESH=60s
POLICY_EVAL_TIMEOUT_MS=5

# --- Gateway: rate limiting + idempotency ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
IDEMPOTENCY_TTL=24h
